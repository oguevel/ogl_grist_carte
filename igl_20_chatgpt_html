<!DOCTYPE html> <html> <head> <meta charset="utf-8"/> <script src="https://docs.getgrist.com/grist-plugin-api.js"></script> <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css"/> <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script> <style> body{ font-family: Arial; margin:0; padding:0; } #controls{ padding:10px; background:#f3f3f3; border-bottom:1px solid #ccc; } .filter{ margin-bottom:8px; } #map{ height:600px; } button{ padding:6px 10px; } </style> </head> <body> <div id="controls"></div>
<button id="updateMap">Mettre à jour la carte</button>

<div id="map"></div> <script> let map; let markers=[]; let departementLayer; let allData=[]; let filteredData=[]; let options; async function init(){ options = await grist.widgetApi.getOptions(); const table = options.table; grist.ready({requiredAccess:'read table'}); grist.onRecords(async (records)=>{ allData = records; buildFilters(); }); initMap(); } function initMap(){ map = L.map('map').setView([46.5,2.5],6); const ignKey="essentiels"; const layer = L.tileLayer( "https://wxs.ign.fr/"+ignKey+"/geoportail/wmts?"+ "layer=GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2"+ "&style=normal"+ "&tilematrixset=PM"+ "&Service=WMTS"+ "&Request=GetTile"+ "&Version=1.0.0"+ "&Format=image/png"+ "&TileMatrix={z}"+ "&TileCol={x}"+ "&TileRow={y}", { tileSize:256 } ); layer.addTo(map); } function buildFilters(){ const container=document.getElementById("controls"); container.innerHTML=""; options.filterColumns.forEach(col=>{ const div=document.createElement("div"); div.className="filter"; const label=document.createElement("div"); label.innerText=col; const select=document.createElement("select"); select.multiple=true; select.id="filter_"+col; const values=[...new Set(allData.map(r=>r[col]))]; values.forEach(v=>{ const opt=document.createElement("option"); opt.value=v; opt.innerText=v; select.appendChild(opt); }); select.addEventListener("change",updateDependentFilters); div.appendChild(label); div.appendChild(select); container.appendChild(div); }); } function updateDependentFilters(){ let currentData = applyFilters(false); options.filterColumns.forEach(col=>{ const select=document.getElementById("filter_"+col); const possible=[...new Set(currentData.map(r=>r[col]))]; [...select.options].forEach(opt=>{ opt.hidden=!possible.includes(opt.value); }); }); } function applyFilters(useMap){ let data=[...allData]; options.filterColumns.forEach(col=>{ const select=document.getElementById("filter_"+col); const selected=[...select.selectedOptions].map(o=>o.value); if(selected.length>0){ data=data.filter(r=>selected.includes(r[col])); } }); if(useMap){ filteredData=data; } return data; } document.getElementById("updateMap").onclick=()=>{ filteredData=applyFilters(true); drawMap(); }; function drawMap(){ markers.forEach(m=>map.removeLayer(m)); markers=[]; if(departementLayer){ map.removeLayer(departementLayer); } let bounds=[]; let departements={}; filteredData.forEach(row=>{ const coords=row[options.latlngColumn]; if(!coords)return; const parts=coords.split(","); const lat=parseFloat(parts[0]); const lon=parseFloat(parts[1]); bounds.push([lat,lon]); const marker=L.marker([lat,lon]); let popup="<b>"+row[options.titleColumn]+"</b><br>"; options.infoColumns.forEach(c=>{ popup+=c+" : "+row[c]+"<br>"; }); marker.bindPopup(popup); marker.addTo(map); markers.push(marker); departements[row[options.departementColumn]]=true; }); if(bounds.length>0){ map.fitBounds(bounds); } drawDepartements(Object.keys(departements)); } async function drawDepartements(deps){ const url="https://geo.api.gouv.fr/departements?geometry=contour"; const res=await fetch(url); const data=await res.json(); const selected=data.filter(d=>deps.includes(d.code)); const features=selected.map(d=>{ return { "type":"Feature", "geometry":d.contour, "properties":{ "code":d.code } }; }); departementLayer=L.geoJSON(features,{ style:function(){ const h=Math.floor(Math.random()*360); return{ color:"#444", weight:1, fillColor:"hsl("+h+",70%,85%)", fillOpacity:0.7 }; } }); departementLayer.addTo(map); } init(); </script> </body> </html>
